{
  "name": "gosilex-chemin-a",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:e2e:design-system": "bun run --filter @gosilex/example-web test:e2e:design-system",
    "test:e2e:ci": "bash scripts/e2e-ci.sh",
    "db:migrate": "bun run --filter @gosilex/example-api db:migrate",
    "db:seed": "bun run --filter @gosilex/example-api db:seed",
    "db:seed:reset": "bun run --filter @gosilex/example-api db:seed:reset",
    "db:reset": "bun run --filter @gosilex/example-api db:reset",
    "extract-dry-run": "bash scripts/extract-dry-run.sh",
    "banlist": "bash scripts/check-banned-strings.sh",
    "zero-edit": "bash scripts/check-zero-edit-zones.sh",
    "import-boundary": "bun run scripts/check-import-boundaries.ts",
    "test:import-boundary": "bash scripts/test-import-boundaries.sh",
    "debt:check": "bun run scripts/check-debt.ts",
    "test:debt": "bash scripts/test-debt.sh",
    "folder-size:check": "bash tools/check_folder_size.sh",
    "agents-adr:check": "bash scripts/check-agents-adr-hygiene.sh",
    "env:check": "bun run scripts/check-env-sync.ts",
    "i18n:check": "bun run --filter @gosilex/example-web test -- src/messages/messages.contract.test.ts",
    "license:check": "bun run tools/licenseChecker.ts",
    "quality-gates:check": "QG_FILE_MODE=tree bash tools/check_file_length.sh && bash tools/check_folder_size.sh",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run banlist && bun run extract-dry-run && bun run zero-edit && bun run env:check",
    "build:kit": "turbo run build --filter=@gosilex/example-api --filter=@gosilex/example-web",
    "smoke:mcp": "bun run --filter @gosilex/mcp-example smoke:stdio",
    "validate:full": "bun run lint && bun run typecheck && bun run banlist && bun run extract-dry-run && bun run zero-edit && bun run import-boundary && bun run test:import-boundary && bun run test:deny-upstream && bun run debt:check && bun run test:debt && bun run agents-adr:check && bun run env:check && bun run test:coverage && bun run license:check && bun run quality-gates:check && bun run build:kit && bun run smoke:mcp",
    "prepare": "git config --get core.hooksPath >/dev/null 2>&1 || lefthook install",
    "dogfood:zero-edit": "bash scripts/dogfood-zero-edit.sh --self-sim",
    "test:deny-upstream": "bash scripts/test-deny-upstream.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@vitest/coverage-v8": "3.2.7",
    "lefthook": "^1.11.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
