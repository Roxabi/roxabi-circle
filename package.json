{
  "name": "cf-chemin-a",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:e2e:design-system": "bun run --filter @kit/example-web test:e2e:design-system",
    "test:e2e:ci": "bash scripts/e2e-ci.sh",
    "db:migrate": "bun run --filter @kit/example-api db:migrate",
    "db:seed": "bun run --filter @kit/example-api db:seed",
    "db:seed:reset": "bun run --filter @kit/example-api db:seed:reset",
    "db:reset": "bun run --filter @kit/example-api db:reset",
    "extract-dry-run": "bash scripts/extract-dry-run.sh",
    "banlist": "bash scripts/check-banned-strings.sh",
    "zod-major": "bash scripts/check-zod-major.sh",
    "ts-major": "bash scripts/check-typescript-major.sh",
    "test:ts-major": "bash scripts/test-typescript-major.sh",
    "zero-edit": "bash scripts/check-zero-edit-zones.sh",
    "import-boundary": "bun run scripts/check-import-boundaries.ts",
    "test:import-boundary": "bash scripts/test-import-boundaries.sh",
    "debt:check": "bun run scripts/check-debt.ts",
    "test:debt": "bash scripts/test-debt.sh",
    "folder-size:check": "bash tools/check_folder_size.sh",
    "agents-adr:check": "bash scripts/check-agents-adr-hygiene.sh",
    "env:check": "bun run scripts/check-env-sync.ts",
    "i18n:check": "bun run --filter @kit/example-web test -- src/messages/messages.contract.test.ts",
    "license:check": "bun run tools/licenseChecker.ts",
    "quality-gates:check": "QG_FILE_MODE=tree bash tools/check_file_length.sh && bash tools/check_folder_size.sh",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run banlist && bun run zod-major && bun run ts-major && bun run extract-dry-run && bun run zero-edit && bun run env:check && bun run wrangler-migrations:check",
    "build:kit": "turbo run build --filter=@kit/example-api --filter=@kit/example-web",
    "cf:showcase:install": "bash scripts/cf-builds/install-monorepo.sh",
    "cf:showcase:deploy-api": "bash scripts/cf-builds/api-deploy.sh",
    "cf:showcase:build-web": "bash scripts/cf-builds/web-build.sh",
    "smoke:mcp": "bun run --filter @kit/mcp-example smoke:stdio",
    "validate:full": "bun run lint && bun run typecheck && bun run banlist && bun run zod-major && bun run ts-major && bun run test:ts-major && bun run extract-dry-run && bun run zero-edit && bun run import-boundary && bun run test:import-boundary && bun run test:deny-upstream && bun run test:kit-schema-sync && bun run check:bar-ssot && bun run test:bar-ssot && bun run test:falsify && bun run wrangler-migrations:check && bun run test:wrangler-migrations && bun run debt:check && bun run test:debt && bun run agents-adr:check && bun run env:check && bun run test:coverage && bun run license:check && bun run quality-gates:check && bun run build:kit && bun run smoke:mcp",
    "prepare": "git config --get core.hooksPath >/dev/null 2>&1 || lefthook install",
    "dogfood:zero-edit": "bash scripts/dogfood-zero-edit.sh --self-sim",
    "test:deny-upstream": "bash scripts/test-deny-upstream.sh",
    "test:kit-schema-sync": "bash scripts/test-kit-schema-sync.sh",
    "check:bar-ssot": "bash scripts/check-bar-ssot.sh",
    "test:bar-ssot": "bash scripts/test-check-bar-ssot.sh",
    "test:falsify": "bash scripts/test-falsify.sh",
    "wrangler-migrations:check": "bash scripts/check-wrangler-migrations-dir.sh",
    "test:wrangler-migrations": "bash scripts/test-wrangler-migrations-dir.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "^2.1.0",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2"
  }
}
