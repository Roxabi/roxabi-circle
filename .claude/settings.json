{
  "enabledPlugins": {
    "agent-browser@agent-browser": true,
    "cloudflare@claude-plugins-official": true,
    "cocoindex-code@cocoindex-code": true,
    "context7@context7-marketplace": true,
    "dev-core@roxabi-marketplace": true,
    "dev-init@roxabi-marketplace": true,
    "forge@roxabi-forge": true,
    "frontend-design@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "improve@improve": true,
    "mcp-server-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "roxabi-issues@roxabi-live-marketplace": true,
    "security-guidance@claude-plugins-official": true,
    "semctx@semctx-stable": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      },
      "autoUpdate": true
    },
    "roxabi-marketplace": {
      "source": {
        "source": "github",
        "repo": "Roxabi/roxabi-plugins"
      },
      "autoUpdate": true
    },
    "roxabi-live-marketplace": {
      "source": {
        "source": "github",
        "repo": "roxabi/roxabi-live"
      }
    },
    "improve": {
      "source": {
        "source": "github",
        "repo": "shadcn/improve"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "roxabi-forge": {
      "source": {
        "source": "github",
        "repo": "Roxabi/roxabi-forge"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cocoindex-code": {
      "source": {
        "source": "github",
        "repo": "cocoindex-io/cocoindex-code"
      },
      "autoUpdate": true
    },
    "semctx-stable": {
      "source": {
        "source": "github",
        "repo": "hoklims/semctx"
      },
      "autoUpdate": true
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/kit/ccc-index-if-ready.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/kit/ccc-index-if-ready.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/kit/semctx-guard-if-present.sh\""
          }
        ]
      }
    ]
  }
}
