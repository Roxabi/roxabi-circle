{
  "name": "@kit/auth",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/better-auth-schema.ts",
      "import": "./src/better-auth-schema.ts",
      "default": "./src/better-auth-schema.ts"
    },
    "./factory": {
      "types": "./src/factory.ts",
      "import": "./src/factory.ts",
      "default": "./src/factory.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./hono": {
      "types": "./src/hono.ts",
      "import": "./src/hono.ts",
      "default": "./src/hono.ts"
    },
    "./repos/memory-d1": null,
    "./repos/*": {
      "types": "./src/repos/*.ts",
      "import": "./src/repos/*.ts",
      "default": "./src/repos/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "echo ok"
  },
  "dependencies": {
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@kit/email": "workspace:*",
    "@kit/ui": "workspace:*",
    "@tanstack/react-form": "^1.12.0",
    "better-auth": ">=1.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": ">=4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@kit/email": {
      "optional": true
    },
    "@kit/ui": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kit/email": "workspace:*",
    "@kit/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
