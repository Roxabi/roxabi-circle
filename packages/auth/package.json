{
  "name": "@gosilex/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
