{
  "$schema": "https://turbo.build/schema.json",
  // Invalidate package task caches when the lockfile (and thus tsc major) changes.
  "globalDependencies": ["bun.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "test:coverage": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
