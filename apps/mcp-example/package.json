{
  "name": "@kit/mcp-example",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:http": "wrangler dev --port 8788",
    "start": "bun run src/index.ts",
    "types": "wrangler types src/worker-configuration.d.ts --include-env=false",
    "typecheck": "wrangler types src/worker-configuration.d.ts --include-env=false --check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run && bun run scripts/stdio-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "smoke:stdio": "bun run scripts/stdio-smoke.mjs",
    "build": "echo ok"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@kit/mcp": "workspace:*",
    "fastmcp": "^4.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.152.0"
  }
}
