# Recorder process (Container or Fly). Never commit real values.
GATEWAY_OPS_SECRET=
PORT=8080
VOICE_RECORD_DUMP_DIR=/tmp/voice-record-spike-a
# Optional HTTP PUT prefix implemented by the Worker outbound handler later.
# Example: http://r2.internal/voice-recordings  (virtual host, not a public URL)
R2_HTTP_PUT_PREFIX=
UDP_PROBE_HOST=1.1.1.1
UDP_PROBE_PORT=53
# Do NOT set a Discord Gateway URL. Do NOT start a discord.js Client.
