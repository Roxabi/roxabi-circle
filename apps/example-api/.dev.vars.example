# Copy to .dev.vars (gitignored). Placeholders only — never commit real secrets.
# ENVIRONMENT must be set for local HMAC fallback / demo seed (not in wrangler [vars]).
ENVIRONMENT=development
# Known kit placeholder — accepted only when ENVIRONMENT=development|test.
# Production/staging: generate a unique secret (openssl rand -base64 48) via CF secrets.
SESSION_SECRET=dev-session-secret-change-me-32chars!!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_USER_EMAIL=demo@gosilex.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Feedback → Spark (../spark `npm run dev` on :3939). Off by default — set FEEDBACK_ENABLED=true to wire UI + proxy.
FEEDBACK_ENABLED=
SPARK_URL=http://localhost:3939
SPARK_FEEDBACK_API_URL=
SPARK_API_KEY=
SPARK_FEEDBACK_API_KEY=
