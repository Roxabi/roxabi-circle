{
  "name": "@kit/example-api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts --include-env=false",
    "typecheck": "wrangler types src/worker-configuration.d.ts --include-env=false --check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply example-api-local --local",
    "db:seed": "bun scripts/seed-local.ts",
    "db:seed:reset": "bun scripts/seed-local.ts --reset",
    "db:reset": "bun run db:migrate && bun run db:seed:reset",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@kit/api-client": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/comments": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "@kit/email": "workspace:*",
    "@kit/flows": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/notifications": "workspace:*",
    "@kit/storage": "workspace:*",
    "@kit/tasks": "workspace:*",
    "@kit/types": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.152.0"
  }
}
