{
  "name": "@kit/example-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply example-api-local --local",
    "db:seed": "bun scripts/seed-local.ts",
    "db:seed:reset": "bun scripts/seed-local.ts --reset",
    "db:reset": "bun run db:migrate && bun run db:seed:reset",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@kit/auth": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "@kit/email": "workspace:*",
    "@kit/comments": "workspace:*",
    "@kit/flows": "workspace:*",
    "@kit/storage": "workspace:*",
    "@kit/tasks": "workspace:*",
    "@kit/types": "workspace:*",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
