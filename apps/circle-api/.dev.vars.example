DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
# Not wired yet — GitHub OAuth is a 501 stub, nothing reads these. Deleted from the
# deployed Worker on 2026-09-03; set them again when the OAuth route lands.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
# Optional PAT (public read-only) for the daily GitHub digest.
# Unset = anonymous api.github.com = 60 req/h per egress IP; one run costs ~48
# (~39 repo metadata + readme of the survivors), so a shared CF IP can starve it.
# Starved runs now fail loudly (`github_rate_limited`) instead of skipping quietly.
GITHUB_TOKEN=

DISCORD_APPEAL_CATEGORY_ID=
# #github-to-watch channel id (Gateway enforces 1 GitHub link top-level)
DISCORD_GITHUB_WATCH_CHANNEL_ID=
# #news-actu channel id (Gateway enforces 1 http(s) link top-level + thread)
DISCORD_NEWS_ACTU_CHANNEL_ID=
# #daily-digest channel id (Gateway: bots only top-level + auto-thread)
DISCORD_DAILY_DIGEST_CHANNEL_ID=
# Temp voice hub (➕ créer un salon) + VOIX category parent
DISCORD_VOICE_HUB_CHANNEL_ID=
DISCORD_VOICE_CATEGORY_ID=
# Ops: POST /internal/discord-gateway/ensure header X-Ops-Secret
GATEWAY_OPS_SECRET=
# Grok Bot desktop → routine "When a webhook fires" → copy URL + sender key.
# Both empty = no-op. Never commit real values.
LYRA_GROK_WEBHOOK_URL=
LYRA_GROK_WEBHOOK_SECRET=
