*.swp
*~

# Monorepo
node_modules/
.turbo/
dist/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
!.dev.vars.example
coverage/
reports/
*.tsbuildinfo
.DS_Store
apps/example-web/dist/
packages/*/dist/

# Local release GIF captures (engine output; do not commit multi-MB blobs)
artifacts/release-gifs/*
!artifacts/release-gifs/.gitkeep

# semctx (agent tool) — denylist: ignore only generated index + local state.
# Everything authored stays tracked: config.json (blocking rules) and semantic/*.sem
# (Plane B intent). An allowlist here is a trap — `.semctx/*` plus one negation silently
# drops whatever the next contributor adds (that is how the config-vs-semantic split arose).
# semctx.db is a ~7.5MB generated SQLite index: binary, unmergeable, rewritten on reindex.
.semctx/semctx.db
.semctx/working/
.semctx/context-packs/

# generated by CI secret-scan step (workspace-local for Docker mount)
trufflehog-exclude.txt
