.claude/worktrees/
.claude/*.lock
.claude/settings.local.json
.grok/
.omp/
*.bak

# Code search index (ccc / cocoindex-code) — machine-local sqlite index
/.cocoindex_code/

# Env / secrets
.env
.env.*
!.env.example

# Cloudflare deploy profile (operator-local; template is config/kit/deploy.cf.example.toml)
config/kit/deploy.cf.local.toml
# Legacy path (pre ADR-0009 kit namespace) — keep ignored so old local files stay untracked
config/deploy.cf.local.toml

# Node / build (future Worker)
node_modules/
dist/
.wrangler/
.dev.vars

# OS / editor
*.swp
*~

# Monorepo
node_modules/
.turbo/
dist/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
!.dev.vars.example
coverage/
reports/
*.tsbuildinfo
.DS_Store
apps/example-web/dist/
packages/*/dist/

# Local release GIF captures (engine output; do not commit multi-MB blobs)
artifacts/release-gifs/*
!artifacts/release-gifs/.gitkeep

# OMP plugin runtime (machine-local). Kit n'autorise pas de wrappers MCP/hooks ici.
.omp/plugins/

# semctx (agent tool) — allowlist aligned with plugin setup (verified 0.1.17).
# Verified on semctx 0.1.17: the writer only emits `.semctx/*` and
# `!.semctx/semantic/`; every other line is preserved verbatim (`setup`
# returns `present`, no rewrite). Extra `!` lines in this file hold by
# preservation, not re-emission — order is therefore not load-bearing.
# Re-check if semctx changes version.
# Policy: each new authored path under `.semctx/` gets a `!` line here.
# `.semctx/working/` is tracked so feature branches can keep handoff/change files;
# a PR must leave only `.gitkeep` (lefthook `pr` + CI job `semctx-working-empty`).
.semctx/*
!.semctx/semantic/
# 0.1.17: on-disk `repositoryRoot` is the author machine's absolute path
# (written at first setup, never rewritten). Load overrides it in memory
# with realpath(cwd) — clones are not broken. Keep tracked (kit include/
# exclude live here); do not untrack.
!.semctx/config.json
!.semctx/working/
!.semctx/guard.json

# generated by CI secret-scan step (workspace-local for Docker mount)
trufflehog-exclude.txt

# Repo-pinned trufflehog binary (scripts/kit/trufflehog-check.sh)
/.cache/trufflehog/

# extract-dry-run compose proof scratch
.tmp/
apps/example-api/.extract-compose-proof-run.ts
