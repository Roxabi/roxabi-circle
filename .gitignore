# OS
.DS_Store
Thumbs.db

# Claude / agent — track settings.json + stack.yml; ignore local-only
.claude/worktrees/
.claude/*.lock
.claude/settings.local.json
.grok/
*.bak

# Code search index (ccc / cocoindex-code) — machine-local sqlite index
/.cocoindex_code/

# OS / editor
*.swp
*~

# Monorepo build
node_modules/
.turbo/
dist/
coverage/
reports/
*.tsbuildinfo
apps/example-web/dist/
packages/*/dist/

# Cloudflare Wrangler local secrets (CF convention for `wrangler dev`)
# Real files never committed; only *.example placeholders.
.wrangler/
.dev.vars
**/.dev.vars
!.dev.vars.example
!**/.dev.vars.example

# Generic env (non-Worker tools / root) — also never commit secrets
.env
.env.*
!.env.example
!**/.env.example

# Separate live repo (Roxabi/circle-applications) — clone alongside; do not nest-commit
/circle-applications/
