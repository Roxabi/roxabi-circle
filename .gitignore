# OS
.DS_Store
Thumbs.db

# Claude / agent — track settings.json + stack.yml; ignore local-only
.claude/worktrees/
.claude/*.lock
.claude/settings.local.json
.grok/
*.bak

# Code search index (ccc / cocoindex-code) — machine-local sqlite index
/.cocoindex_code/

# OS / editor
*.swp
*~

# Monorepo build
node_modules/
.turbo/
dist/
coverage/
reports/
*.tsbuildinfo
apps/example-web/dist/
packages/*/dist/

# Cloudflare Wrangler local secrets (CF convention for `wrangler dev`)
# Real files never committed; only *.example placeholders.
.wrangler/
.dev.vars
**/.dev.vars
!.dev.vars.example
!**/.dev.vars.example

# Generic env (non-Worker tools / root) — also never commit secrets
.env
.env.*
!.env.example
!**/.env.example

# Local release GIF captures (engine output; do not commit multi-MB blobs)
artifacts/release-gifs/*
!artifacts/release-gifs/.gitkeep

# semctx local state (agent tool)
.semctx/

# generated by CI secret-scan step (workspace-local for Docker mount)
trufflehog-exclude.txt
